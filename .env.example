# ==============================================================================
# PROYECTO PRUEBA - PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a '.env' y completa los valores correspondientes.
# ==============================================================================

# Entorno de Ejecución y Puertos
NODE_ENV=development
PORT=4000
BACKEND_PORT=4000

# Gateway y Supabase On-Premise
SUPABASE_URL=http://192.168.0.70:8010
KONG_HTTP_PORT=8000
SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui
ANON_KEY=tu_supabase_anon_key_aqui

# Frontend (Vite)
VITE_SUPABASE_URL=http://192.168.0.70:8010
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Integraciones Externas & IA
GEMINI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
HUBSPOT_CLIENT_SECRET=
